# Copy: cp docker/compose.env.example docker/compose.env
# Build-time only (Vite bakes into the bundle). Use with: docker compose --env-file docker/compose.env up -d --build
#
# From the browser, APIs are your machine or public URLs (not host.docker.internal).

# Auth (Docker on host :8000)
VITE_AUTH_SERVICE_URL=http://localhost:8000/api/v1
VITE_ORDER_SERVICE_URL=http://localhost:8001/api
VITE_PRODUCT_SERVICE_URL=http://localhost:5001/api/v1
VITE_ECOMMERCE_READ_SERVICE_URL=http://localhost:5004
VITE_ECOMMERCE_READ_GRAPHQL_URL=http://localhost:5004/graphql
VITE_SHIPPING_SERVICE_URL=http://localhost:5005/api/v1

# Public client keys
VITE_STRIPE_PUBLIC_KEY=
VITE_RECAPTCHA_SITE_KEY=
VITE_MAP_PROVIDER=osm
VITE_GOOGLE_MAPS_API_KEY=
VITE_USE_MOCK_API=false