# syntax=docker/dockerfile:1

########################################################
# Build Stage
########################################################
FROM node:20-alpine AS builder

WORKDIR /app

COPY src/package*.json ./

RUN npm ci

COPY src/ .

# Copy the repository-root public assets (e.g. logo.svg) into the app's public dir,
# so Vite can serve /logo.svg from the built output.
COPY public/ ./public

# Build-time variables
ARG VITE_AUTH_SERVICE_URL
ARG VITE_PRODUCT_SERVICE_URL
ARG VITE_ORDER_SERVICE_URL
ARG VITE_SHIPPING_SERVICE_URL
ARG VITE_INVOICE_SERVICE_URL
ARG VITE_ACCOUNTING_SERVICE_URL
ARG VITE_PROMOTION_SERVICE_URL
ARG VITE_TAX_SERVICE_URL
ARG VITE_ECOMMERCE_READ_GRAPHQL_URL
ARG VITE_WAREHOUSE_SERVICE_URL
ARG VITE_MAP_PROVIDER
ARG VITE_USE_MOCK_API
ARG VITE_RECAPTCHA_SITE_KEY
ARG VITE_ECOMMERCE_READ_SERVICE_URL
ARG VITE_ASSET_BASE_URL
ARG VITE_BFF_SERVICE_URL
ARG VITE_NOTIFICATION_SERVICE_URL
ARG VITE_NOTIFICATION_SOCKET_PATH

# Runtime variables
ENV VITE_RECAPTCHA_SITE_KEY=$VITE_RECAPTCHA_SITE_KEY
ENV VITE_ECOMMERCE_READ_SERVICE_URL=$VITE_ECOMMERCE_READ_SERVICE_URL
ENV VITE_ASSET_BASE_URL=$VITE_ASSET_BASE_URL
ENV VITE_AUTH_SERVICE_URL=$VITE_AUTH_SERVICE_URL
ENV VITE_PRODUCT_SERVICE_URL=$VITE_PRODUCT_SERVICE_URL
ENV VITE_ORDER_SERVICE_URL=$VITE_ORDER_SERVICE_URL
ENV VITE_SHIPPING_SERVICE_URL=$VITE_SHIPPING_SERVICE_URL
ENV VITE_WAREHOUSE_SERVICE_URL=$VITE_WAREHOUSE_SERVICE_URL
ENV VITE_INVOICE_SERVICE_URL=$VITE_INVOICE_SERVICE_URL
ENV VITE_ACCOUNTING_SERVICE_URL=$VITE_ACCOUNTING_SERVICE_URL
ENV VITE_PROMOTION_SERVICE_URL=$VITE_PROMOTION_SERVICE_URL
ENV VITE_ECOMMERCE_READ_GRAPHQL_URL=$VITE_ECOMMERCE_READ_GRAPHQL_URL
ENV VITE_MAP_PROVIDER=$VITE_MAP_PROVIDER
ENV VITE_USE_MOCK_API=$VITE_USE_MOCK_API
ENV VITE_BFF_SERVICE_URL=$VITE_BFF_SERVICE_URL
ENV VITE_NOTIFICATION_SERVICE_URL=$VITE_NOTIFICATION_SERVICE_URL
ENV VITE_NOTIFICATION_SOCKET_PATH=$VITE_NOTIFICATION_SOCKET_PATH
ENV VITE_TAX_SERVICE_URL=$VITE_TAX_SERVICE_URL
ENV VITE_DELIVERY_SERVICE_URL=$VITE_DELIVERY_SERVICE_URL
ENV NODE_OPTIONS="--max-old-space-size=1024"
RUN npm run build

########################################################
# Production Stage
########################################################
FROM nginx:stable-alpine

RUN rm -f /etc/nginx/conf.d/default.conf

COPY docker/nginx/frontend.conf /etc/nginx/conf.d/frontend.conf

COPY --from=builder /app/dist /var/www/html/frontend

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]