# syntax=docker/dockerfile:1

########################################################
# Build Stage
########################################################
FROM node:20-alpine AS builder

WORKDIR /app

COPY src/package*.json ./

RUN npm ci

COPY src/ .

# -----------------------------
# Build-time variables ONLY
# -----------------------------
ARG VITE_AUTH_SERVICE_URL
ARG VITE_PRODUCT_SERVICE_URL
ARG VITE_ORDER_SERVICE_URL
ARG VITE_ECOMMERCE_READ_GRAPHQL_URL
ARG VITE_MAP_PROVIDER
ARG VITE_USE_MOCK_API

ENV VITE_AUTH_SERVICE_URL=$VITE_AUTH_SERVICE_URL
ENV VITE_PRODUCT_SERVICE_URL=$VITE_PRODUCT_SERVICE_URL
ENV VITE_ORDER_SERVICE_URL=$VITE_ORDER_SERVICE_URL
ENV VITE_ECOMMERCE_READ_GRAPHQL_URL=$VITE_ECOMMERCE_READ_GRAPHQL_URL
ENV VITE_MAP_PROVIDER=$VITE_MAP_PROVIDER
ENV VITE_USE_MOCK_API=$VITE_USE_MOCK_API

RUN npm run build

########################################################
# Production Stage
########################################################
FROM nginx:stable-alpine

RUN rm -f /etc/nginx/conf.d/default.conf

COPY docker/nginx/frontend.conf /etc/nginx/conf.d/frontend.conf

COPY --from=builder /app/dist /var/www/html/frontend

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]