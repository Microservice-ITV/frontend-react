APP_NAME=FrontendService
APP_ENV=local
APP_PORT=3000

# NODE
NODE_CONTAINER_NAME=frontend-node
NODE_WORKING_DIR=/app

# NGINX
NGINX_CONTAINER_NAME=frontend-nginx
NGINX_WORKING_DIR=/var/www/html

# NETWORK
NETWORK_NAME=itv-network

# Build-time VITE_* environment variables
# These are baked into the bundle at build time (npm run build).
# For dev (npm run dev), Vite reads them from the environment at runtime.
VITE_AUTH_SERVICE_URL=http://localhost:8000/api/v1
VITE_ORDER_SERVICE_URL=http://localhost:8001/api
VITE_PRODUCT_SERVICE_URL=http://localhost:5001/api/v1
VITE_ECOMMERCE_READ_SERVICE_URL=http://localhost:5004
VITE_ECOMMERCE_READ_GRAPHQL_URL=http://localhost:5004/graphql
VITE_SHIPPING_SERVICE_URL=http://localhost:5005/api/v1
VITE_STRIPE_PUBLIC_KEY=
VITE_RECAPTCHA_SITE_KEY=6LcWekksAAAAAEdGw5imUV9pqveS6NFjlB13JOwZ
VITE_MAP_PROVIDER=osm
VITE_GOOGLE_MAPS_API_KEY=
VITE_USE_MOCK_API=false
