APP_NAME=FrontendService
APP_ENV=production
APP_PORT=3000

# NETWORK
NETWORK_NAME=itv-network

# NODE
NODE_CONTAINER_NAME=node
NODE_WORKING_DIR=/app

# NGINX
NGINX_CONTAINER_NAME=nginx


DOCKER_IMAGE=frontend-react
DOCKER_USERNAME=dailyneeditems
IMAGE_TAG=latest

# Build-time VITE_* environment variables
# These are baked into the bundle at build time (npm run build).
# For dev (npm run dev), Vite reads them from the environment at runtime.
# ===========================
# VITE (IMPORTANT - BUILD TIME)
# ===========================

 VITE_AUTH_SERVICE_URL=https://api.dailyneeditems.com/auth
