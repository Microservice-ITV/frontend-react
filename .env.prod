# VITE_ECOMMERCE_READ_GRAPHQL_URL=https://api.dailyneeditems.com/graphql

# VITE_SHIPPING_SERVICE_URL=https://api.dailyneeditems.com/shipping

 VITE_STRIPE_PUBLIC_KEY=
